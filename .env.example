# Copy to backend/.env (cd backend && cp ../.env.example .env). Never commit the real file.

# 1 = serve canned outputs from fixtures/api/llm/ (no provider, no key needed)
MOCK_LLM=1

# Provider behind backend/app/llm/client.py.
# LLM_PROVIDER: openai | anthropic | openai_compatible
#   openai            -> https://api.openai.com/v1
#   anthropic         -> https://api.anthropic.com/v1
#   openai_compatible -> needs LLM_BASE_URL (for example Gemini's OpenAI endpoint, Groq, a local server)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Only for openai_compatible (or to override the default base URL)
LLM_BASE_URL=

# 0 disables the on-disk response cache (consistency tests only)
LLM_CACHE=1
# Per call timeout in seconds
LLM_TIMEOUT_S=30

DATABASE_URL=sqlite:///./vivagrade.db

# 1 = start background grading when a student submits
GRADE_ON_SUBMIT=1

# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
