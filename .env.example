# Copy to backend/.env (cd backend && cp ../.env.example .env). Never commit the real file.

# 1 = serve canned outputs from fixtures/api/llm/ (no provider, no key needed)
MOCK_LLM=1

# Provider behind backend/app/llm/client.py.
# LLM_PROVIDER (the first provider tried): groq | gemini | openai | anthropic | openai_compatible
#   openai            -> https://api.openai.com/v1
#   anthropic         -> https://api.anthropic.com/v1
#   openai_compatible -> needs LLM_BASE_URL (a local server or any OpenAI style API)
# Simple setup: one provider, one key.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Only for openai_compatible (or to override the default base URL)
LLM_BASE_URL=

# Key pool (optional). Calls rotate round-robin over a provider's keys. A key that is rate
# limited, down or rejected is skipped for a while, then the next key and then the next
# provider in LLM_ORDER is tried. Comma separated, no spaces needed. Never commit real keys.
LLM_ORDER=groq,gemini
LLM_GROQ_KEYS=
LLM_GROQ_MODEL=openai/gpt-oss-120b
LLM_GEMINI_KEYS=
LLM_GEMINI_MODEL=gemini-3.5-flash

# 0 disables the on-disk response cache (consistency tests only)
LLM_CACHE=1
# Per call timeout in seconds
LLM_TIMEOUT_S=30

DATABASE_URL=sqlite:///./vivagrade.db

# 1 = start background grading when a student submits
GRADE_ON_SUBMIT=1

# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
